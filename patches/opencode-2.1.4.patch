+export const TOAST_SOUND_CATEGORIES = [
+  {
+    id: "session",
+    title: "settings.general.sounds.toasts.session.title",
+    description: "settings.general.sounds.toasts.session.description",
+  },
+  {
+    id: "project",
+    title: "settings.general.sounds.toasts.project.title",
+    description: "settings.general.sounds.toasts.project.description",
+  },
+  {
+    id: "workspace",
+    title: "settings.general.sounds.toasts.workspace.title",
+    description: "settings.general.sounds.toasts.workspace.description",
+  },
+  {
+    id: "provider",
+    title: "settings.general.sounds.toasts.provider.title",
+    description: "settings.general.sounds.toasts.provider.description",
+  },
+  {
+    id: "composer",
+    title: "settings.general.sounds.toasts.composer.title",
+    description: "settings.general.sounds.toasts.composer.description",
+  },
+  {
+    id: "request",
+    title: "settings.general.sounds.toasts.request.title",
+    description: "settings.general.sounds.toasts.request.description",
+  },
+  {
+    id: "server",
+    title: "settings.general.sounds.toasts.server.title",
+    description: "settings.general.sounds.toasts.server.description",
+  },
+  {
+    id: "settings",
+    title: "settings.general.sounds.toasts.settings.title",
+    description: "settings.general.sounds.toasts.settings.description",
+  },
+] as const
+
+export type ToastSoundCategory = (typeof TOAST_SOUND_CATEGORIES)[number]["id"]
+
+export type ToastSoundSettings = {
+  enabled: boolean
+  sound: string
+  overrides: Record<string, string>
+}
+
+export function resolveToastSound(
+  settings: ToastSoundSettings,
+  input: { kind?: ToastSoundCategory; silent?: boolean },
+) {
+  if (input.silent) return undefined
+
+  const override = input.kind ? settings.overrides[input.kind] : undefined
+
+  if (override === "none") return undefined
+
+  if (override) return override
+
+  if (!settings.enabled) return undefined
+
+  return settings.sound === "none" ? undefined : settings.sound
+}
