diff --git a/packages/app/src/home/sessions/drag.ts b/packages/app/src/home/sessions/drag.ts
new file mode 100644
index 0000000..d226738
--- /dev/null
+++ b/packages/app/src/home/sessions/drag.ts
@@ -0,0 +1,46 @@
+import type { ServerConnection } from "@/runtime/server/registry"
+import { pathKey } from "@/workspaces/path-key"
+
+// Custom type lets drop targets recognize home session drags and keeps the
+// payload out of the clipboard while other drag sources are active.
+export const HOME_SESSION_DRAG_TYPE = "application/x-opencode-home-session"
+
+export type HomeSessionDrag = {
+  server: ServerConnection.Key
+  sessionID: string
+  // Project that currently owns the session, resolved with the same sandbox
+  // and project-ID rules as the row. A session cannot move to its own project.
+  project: string
+}
+
+// The same window owns the drag source and every drop target. A module-level
+// reference avoids routing transient pointer state through the whole page.
+let active: HomeSessionDrag | undefined
+
+export function beginHomeSessionDrag(event: DragEvent, drag: HomeSessionDrag) {
+  active = drag
+  // Chromium only starts a native drag once some data is set. The custom type
+  // is what drop targets check; the plain text keeps the browser fallback sane.
+  event.dataTransfer?.setData(HOME_SESSION_DRAG_TYPE, drag.sessionID)
+  event.dataTransfer?.setData("text/plain", drag.sessionID)
+
+  if (event.dataTransfer) event.dataTransfer.effectAllowed = "move"
+}
+
+// Returns the drag when the target can accept it. Servers are separate
+// session stores, so only projects on the session's own server qualify.
+export function homeSessionDrop(event: DragEvent, server: ServerConnection.Key, project: string) {
+  const drag = active
+
+  if (!drag || drag.server !== server) return
+
+  if (pathKey(drag.project) === pathKey(project)) return
+
+  if (!event.dataTransfer?.types.includes(HOME_SESSION_DRAG_TYPE)) return
+
+  return drag
+}
+
+export function endHomeSessionDrag() {
+  active = undefined
+}
