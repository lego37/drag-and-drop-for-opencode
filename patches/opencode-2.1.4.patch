diff --git a/packages/app/src/shell/notifications/toast-sound.test.ts b/packages/app/src/shell/notifications/toast-sound.test.ts
new file mode 100644
index 0000000..75a5cb5
--- /dev/null
+++ b/packages/app/src/shell/notifications/toast-sound.test.ts
@@ -0,0 +1,32 @@
+import { describe, expect, test } from "bun:test"
+import { resolveToastSound } from "./toast-sound"
+
+const settings = (overrides: Record<string, string> = {}) => ({
+  enabled: true,
+  sound: "bip-bop-01",
+  overrides,
+})
+
+describe("toast sounds", () => {
+  test("falls back to the general sound", () => {
+    expect(resolveToastSound(settings(), { kind: "session" })).toBe("bip-bop-01")
+    expect(resolveToastSound({ ...settings(), enabled: false }, { kind: "session" })).toBeUndefined()
+  })
+
+  test("uses a configured toast sound even when the general sound is off", () => {
+    expect(resolveToastSound(settings({ session: "yup-02" }), { kind: "session" })).toBe("yup-02")
+    expect(resolveToastSound({ ...settings({ session: "yup-02" }), enabled: false }, { kind: "session" })).toBe("yup-02")
+  })
+
+  test("lets a toast silence its own sound", () => {
+    expect(resolveToastSound(settings({ session: "none" }), { kind: "session" })).toBeUndefined()
+  })
+
+  test("keeps dedicated toast sounds from playing twice", () => {
+    expect(resolveToastSound(settings({ session: "yup-02" }), { kind: "session", silent: true })).toBeUndefined()
+  })
+
+  test("uses the general sound for uncategorized toasts", () => {
+    expect(resolveToastSound(settings(), {})).toBe("bip-bop-01")
+  })
+})
